[Unit]
Description=vLLM Inference Server (Qwen2.5-7B-Instruct-AWQ)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=VLLM_ATTENTION_BACKEND=FLASHINFER
ExecStart=/usr/local/bin/vllm serve Qwen/Qwen2.5-7B-Instruct-AWQ \
    --host 0.0.0.0 \
    --port 8000 \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.90 \
    --dtype auto \
    --quantization awq
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
