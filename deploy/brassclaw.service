[Unit]
Description=BrassClaw AI Assistant
After=cloud-sql-proxy.service docker.service
Requires=cloud-sql-proxy.service

[Service]
Type=simple
EnvironmentFile=/opt/brassclaw/.env
# Pin to a specific version tag or digest instead of :latest to prevent
# uncontrolled deployments. Update BRASSCLAW_VERSION in /opt/brassclaw/.env
# or replace the tag below when deploying a new release.
ExecStartPre=/bin/bash -c 'docker pull us-central1-docker.pkg.dev/brassclaw-prod/brassclaw/agent:${BRASSCLAW_VERSION:-latest}'
ExecStart=/bin/bash -c 'docker run --rm \
  --name brassclaw \
  --env-file /opt/brassclaw/.env \
  -p 3000:3000 \
  us-central1-docker.pkg.dev/brassclaw-prod/brassclaw/agent:${BRASSCLAW_VERSION:-latest} \
  --no-onboard'
ExecStop=/usr/bin/docker stop brassclaw
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
