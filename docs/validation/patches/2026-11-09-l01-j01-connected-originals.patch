+// The borrowed capture form has the exact /2 field order and encoding. Count
+// complete escaping before copying any root string or allocating an output.
+#[derive(Serialize)]
+struct CaptureWire<'a> {
+    format: &'static str,
+    work_id: Uuid,
+    run_id: Uuid,
+    request_checksum: [u8; 32],
