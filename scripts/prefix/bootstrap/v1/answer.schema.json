{
  "type": "object",
  "properties": {
    "schema": {
      "const": "brassclaw-bootstrap-answer/1"
    },
    "task": {
      "enum": [
        "extract_bootstrap_facts",
        "select_bootstrap_prefill"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "task",
    "request_id",
    "input_sha256",
    "result"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brassclaw:bootstrap-answer:1",
  "description": "Structural response only. Native request correlation, exact integer representation/bounds, exact required field/scope coverage, source provenance, contradiction, option applicability, protected values and CAS are mandatory local checks; no approval or prefill permission.",
  "oneOf": [
    {
      "properties": {
        "task": {
          "const": "extract_bootstrap_facts"
        },
        "result": {
          "type": "object",
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "issues": {
              "$ref": "#/$defs/issues"
            }
          },
          "required": [
            "facts",
            "issues"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "task": {
          "const": "select_bootstrap_prefill"
        },
        "result": {
          "type": "object",
          "properties": {
            "candidate_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "issues": {
              "$ref": "#/$defs/issues"
            }
          },
          "required": [
            "candidate_id",
            "issues"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "locator",
        "quote"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "field": {
          "enum": [
            "context_window_tokens",
            "output_limit_tokens",
            "tokenizer_identity",
            "template_identity",
            "supports_tools",
            "supports_reasoning"
          ]
        },
        "scope": {
          "enum": [
            "endpoint_configuration",
            "model_declared"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "unknown",
            "conflict"
          ]
        },
        "value": {
          "type": [
            "integer",
            "string",
            "boolean",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "field",
        "scope",
        "status",
        "value",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proposed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "field": {
                      "enum": [
                        "context_window_tokens",
                        "output_limit_tokens"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "field": {
                      "enum": [
                        "tokenizer_identity",
                        "template_identity"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "field": {
                      "enum": [
                        "supports_tools",
                        "supports_reasoning"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "missing_evidence",
          "conflicting_evidence",
          "target_mismatch",
          "unsupported_capability",
          "no_applicable_option",
          "ambiguous_options",
          "protected_existing_value"
        ]
      }
    }
  }
}
