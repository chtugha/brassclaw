root_prop_3_additional_prop_0 ::= (("21") | ("22"))
root_prop_3_additional_part_0 ::= ((", " "\"payload\"" ": " basic_object))
root_prop_3_items ::= ((", " root_prop_3_additional))
root_prop_4 ::= (("[" root_prop_4_additional root_prop_4_items{0, -1} "]") | ("[" "]"))
root_prop_4_additional ::= (("[" basic_string ", " basic_string "]"))
root_prop_4_items ::= ((", " root_prop_4_additional))
root_prop_6 ::= (("[" root_prop_6_additional root_prop_6_items{4, 4} "]"))
root_prop_6_additional ::= (("[" basic_string ", " basic_string "]"))
root_prop_6_items ::= ((", " root_prop_6_additional))
root_part_5 ::= ((", " "\"adjusted_volatile_messages\"" ": " root_prop_6))
root_part_4 ::= ((", " "\"proposed_intent_examples\"" ": " basic_array root_part_5))
root_part_3 ::= ((", " "\"bridge_messages\"" ": " root_prop_4 root_part_4))
root_part_2 ::= ((", " "\"proposed_components\"" ": " root_prop_3 root_part_3))
root_part_1 ::= ((", " "\"proposed_recipe_updates\"" ": " basic_array root_part_2))
root_part_0 ::= ((", " "\"composition_summary\"" ": " basic_string root_part_1))
basic_integer_1 ::= ("" | ("-"))
basic_number_1 ::= ("" | ("-"))
basic_number_2 ::= (("0") | ([1-9] [0-9]*))
basic_number_3 ::= ("" | ("." basic_number_digits{1, -1}))
basic_number_4 ::= ("" | ([+\-]))
basic_number_5 ::= ("" | ([eE] basic_number_4 basic_number_digits{1, -1}))
