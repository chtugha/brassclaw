+        .unwrap_or_else(|_| out_of_memory(format_args!("monty worker: allocation layout overflow")))
+}
+
+fn allocation_is_vm_owned() -> bool {
+    VM_MEMORY_ACCOUNTING.load(Ordering::Acquire) && VM_SCOPE.try_with(Cell::get).unwrap_or(false)
+}
