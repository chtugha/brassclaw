+    /// Attach trusted control without resetting consumption or terminal failure.
+    /// Reattachment after loading a controlled dump is mandatory. It does not
+    /// clear a failure already observed while control was unavailable.
+    pub fn set_execution_control(&mut self, control: Arc<dyn ExecutionControl>) {
+        self.execution_control = Some(control);
+        self.control_required = true;
+    }
+
+    fn poll_execution_control(&self) -> Result<(), ResourceError> {
+        if let Some(error) = self.control_error.get() {
+            return Err(ResourceError::Control(error));
+        }
+        if !self.control_required {
+            return Ok(());
+        }
+        let outcome = self
+            .execution_control
+            .as_ref()
+            .ok_or(ExecutionControlError::AccountingUnavailable)
+            .and_then(|control| control.checkpoint(self.elapsed()));
+        match outcome {
+            Ok(ExecutionControlAction::Continue) => Ok(()),
+            Ok(ExecutionControlAction::Yield) => {
+                self.control_yield.set(true);
+                Ok(())
+            }
+            Err(error) => {
+                self.control_error.set(Some(error));
+                Err(ResourceError::Control(error))
+            }
+        }
+    }
+
+    /// Consume a requested yield only at a snapshot-safe bytecode boundary.
+    /// Native synchronous reentry must leave this request pending.
+    pub fn take_control_yield(&self) -> bool {
+        self.control_yield.replace(false)
+    }
+
